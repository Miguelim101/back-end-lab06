# Copiar este archivo como .env (excluido de Git) y completar los valores.
# Spring Boot lo importa automáticamente (spring.config.import en application.yaml).

# Conexión a PostgreSQL (OPCIONAL). Si no se definen, se usan los valores por defecto del
# contenedor todo-postgres del Lab 6 (ver application.yaml). Descomentar solo para cambiarlos.
# DB_URL=jdbc:postgresql://localhost:5432/todo_db
# DB_USER=todo_user
# DB_PASSWORD=

# Llave de firma HMAC del JWT (OBLIGATORIA, mínimo 32 bytes en Base64). Generar con:
#   openssl rand -base64 32
JWT_SECRET=
