@startuml c4_2_containers
' C4 · Nivel 2 · Contenedores (Lab 7: comunicación autenticada con JWT)
!include <C4/C4_Container>

AddElementTag("nuevo", $bgColor="#0b6e4f", $fontColor="#ffffff", $legendText="Nuevo o modificado en Lab 7")
title ToDo · Nivel 2 · Contenedores

Person(user, "Usuario / Administrador", "Rol USER o ADMIN")

System_Boundary(todo, "Sistema ToDo") {
    Container(spa, "Front-end SPA", "React 19 + Vite (:5173)", "Login, registro, tareas, calendario y cierre de sesión. JWT solo en memoria; ante un 401 vuelve al login.", $tags="nuevo")
    Container(api, "API REST", "Spring Boot 4 + Spring Security (:8080)", "Emite y valida JWT (HS256, 30 min). Aísla las tareas por propietario y reserva /admin a ADMIN.", $tags="nuevo")
    ContainerDb(db, "Base de datos", "PostgreSQL 17 (Docker: todo-postgres)", "Tablas users y tasks (FK tasks.user_id -> users.id).", $tags="nuevo")
}

Rel(user, spa, "Usa", "Navegador")
Rel(spa, api, "POST /auth/register, /auth/login (público)", "JSON / HTTP")
Rel(spa, api, "/tasks, /users/me, /admin/summary", "JSON / HTTP + Authorization: Bearer <JWT>")
Rel(api, db, "Lee y escribe", "JPA / Hibernate · JDBC")
SHOW_LEGEND()
@enduml
