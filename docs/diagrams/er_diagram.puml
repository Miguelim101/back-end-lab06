@startuml er_diagram
' Modelo entidad-relación · PostgreSQL todo_db (Lab 7)
hide circle
skinparam linetype ortho
title ToDo · Modelo entidad-relación (Lab 7)

entity "users" as users <<nuevo>> {
  * id : BIGSERIAL <<PK>>
  --
  * name : VARCHAR(100)
  * email : VARCHAR(255) <<UNIQUE, minúsculas>>
  * password_hash : VARCHAR(100)
  * role : VARCHAR(10) <<CHECK USER | ADMIN>>
  * created_at : TIMESTAMP
}

entity "tasks" as tasks {
  * id : BIGSERIAL <<PK>>
  --
  * title : VARCHAR(120)
  description : VARCHAR(500)
  * status : VARCHAR(20) <<CHECK>>
  * priority : VARCHAR(10) <<CHECK>>
  due_date : DATE
  * created_at : TIMESTAMP
  * user_id : BIGINT <<FK fk_tasks_user, NOT NULL, nuevo>>
}

users ||--o{ tasks : "es propietario de\n(ON DELETE CASCADE)"

note right of tasks
  Índice idx_tasks_user_id para las
  consultas por propietario.
  Las tareas del Lab 6 se asignaron
  al usuario legacy@todo.local (003).
end note
@enduml
